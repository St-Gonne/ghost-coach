# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ghost_coach
PORT=8080

# Default local mode
NODE_ENV=development
MOCK_INTEGRATIONS=true
LOG_LEVEL=info
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080

# Required for real Phase 2 integrations when MOCK_INTEGRATIONS=false
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY_BASE64=
INTERNAL_CRON_SECRET=
ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional or later-phase integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_ALLOWED_USER_ID=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash-lite
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
